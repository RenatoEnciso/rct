      "html": "<div class=\"ds-sellos\"><span class=\"ds-b ds-b-ok\">Aprobado</span><span class=\"ds-b ds-b-pend\">Observado</span><span class=\"ds-b ds-b-no\">Rechazado</span><span class=\"ds-b ds-b-info\">En curso</span><span class=\"ds-b\">Borrador</span></div>",
      "css": ".ds-sellos{display:flex;gap:6px;flex-wrap:wrap;font-family:'Inter',system-ui,sans-serif}.ds-b{display:inline-flex;align-items:center;padding:2px 8px;border:1px solid #e3e6ea;border-radius:4px;background:#f8f9fa;color:#5f6b7a;font-size:12px;font-weight:500;line-height:18px}.ds-b-ok{background:#ecf6f0;color:#1f7a4d;border-color:#c6e3d2}.ds-b-pend{background:#fdf5e7;color:#a15c07;border-color:#f1dbb1}.ds-b-no{background:#fdf0ef;color:#b42318;border-color:#f3cdc9}.ds-b-info{background:#edf2f9;color:#1f4e8c;border-color:#c9d7ec}"
