  "components": [
    {
      "name": "Botón principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Única acción principal de cada vista.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Nueva propuesta FUD</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:36px;padding:7px 14px;border:1px solid transparent;border-radius:6px;font-family:'Inter',system-ui,sans-serif;font-size:13px;font-weight:600;line-height:1.2;cursor:pointer;transition:background-color 160ms,border-color 160ms,color 160ms}.ds-btn:focus-visible{outline:none;box-shadow:0 0 0 2px #fff,0 0 0 4px #a3182c}.ds-btn-primary{background:#a3182c;border-color:#a3182c;color:#fff}.ds-btn-primary:hover,.ds-btn-primary:active{background:#7d1221;border-color:#7d1221}"
    },
    {
      "name": "Botón secundario",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Acciones secundarias y acciones repetidas por fila.",
      "html": "<button class=\"ds-btn-sec\">Exportar</button>",
      "css": ".ds-btn-sec{display:inline-flex;align-items:center;gap:7px;min-height:36px;padding:7px 14px;border:1px solid #cfd4da;border-radius:6px;background:#fff;color:#1c2430;font-family:'Inter',system-ui,sans-serif;font-size:13px;font-weight:500;cursor:pointer;transition:background-color 160ms,border-color 160ms}.ds-btn-sec:hover{background:#f8f9fa;border-color:#8a94a3}.ds-btn-sec:focus-visible{outline:none;box-shadow:0 0 0 2px #fff,0 0 0 4px #a3182c}"
    },
    {
      "name": "Botones de decisión",
      "kind": "button",
      "refersTo": "button-success",
      "description": "Aprobar (verde lleno); Observar y Rechazar en contorno de su color.",
      "html": "<div class=\"ds-dec\"><button class=\"ds-d ds-ok\">Aprobar</button><button class=\"ds-d ds-warn\">Observar</button><button class=\"ds-d ds-no\">Rechazar</button></div>",
      "css": ".ds-dec{display:flex;gap:8px}.ds-d{min-height:36px;padding:7px 14px;border:1px solid;border-radius:6px;font-family:'Inter',system-ui,sans-serif;font-size:13px;font-weight:600;cursor:pointer;background:#fff;transition:background-color 160ms}.ds-d:focus-visible{outline:none;box-shadow:0 0 0 2px #fff,0 0 0 4px #a3182c}.ds-ok{background:#1f7a4d;border-color:#1f7a4d;color:#fff}.ds-ok:hover{background:color-mix(in srgb,#000 18%,#1f7a4d)}.ds-warn{border-color:#f1dbb1;color:#a15c07}.ds-warn:hover{background:#fdf5e7}.ds-no{border-color:#f3cdc9;color:#b42318}.ds-no:hover{background:#fdf0ef}"
    },
    {
      "name": "Campo",
      "kind": "input",
      "refersTo": "input",
      "description": "Etiqueta de 13 px sobre control de 36 px con foco rojo.",
      "html": "<label class=\"ds-field\"><span>Monto propuesto <b>*</b></span><input placeholder=\"S/ 0.00\"><small>Monto que el cliente pagará.</small></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;font-family:'Inter',system-ui,sans-serif;max-width:280px}.ds-field span{font-size:13px;font-weight:500;color:#1c2430}.ds-field b{color:#a3182c}.ds-field input{min-height:36px;padding:7px 11px;border:1px solid #cfd4da;border-radius:6px;background:#fff;color:#1c2430;font:inherit;font-size:13px;transition:border-color 160ms,box-shadow 160ms}.ds-field input:hover:not(:focus){border-color:#8a94a3}.ds-field input:focus{outline:0;border-color:#a3182c;box-shadow:0 0 0 3px color-mix(in srgb,#a3182c 16%,transparent)}.ds-field small{font-size:12px;color:#5f6b7a}"
    },
    {
      "name": "Riel de navegación",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Riel tinta con rótulos de grupo e ítem activo en rojo.",
      "html": "<nav class=\"ds-riel\"><div class=\"ds-grupo\">Aprobación y control</div><a class=\"ds-nav ds-activo\" href=\"#\">Bandeja de aprobación <span class=\"ds-cnt\">4</span></a><a class=\"ds-nav\" href=\"#\">Mis aprobaciones</a><a class=\"ds-nav\" href=\"#\">Revisión de sustentos</a></nav>",
      "css": ".ds-riel{width:256px;padding:12px;background:#1c2430;font-family:'Inter',system-ui,sans-serif}.ds-grupo{margin:8px 10px 6px;font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:#8a94a3}.ds-nav{display:flex;align-items:center;gap:10px;min-height:34px;padding:6px 10px;margin-bottom:2px;border-radius:6px;color:#cfd4da;font-size:13px;font-weight:500;text-decoration:none;transition:background-color 160ms,color 160ms}.ds-nav:hover{background:color-mix(in srgb,#fff 7%,#1c2430);color:#fff}.ds-nav:focus-visible{outline:none;box-shadow:0 0 0 2px #1c2430,0 0 0 4px #fff}.ds-activo{background:#a3182c;color:#fff;font-weight:600}.ds-activo:hover{background:#a3182c}.ds-cnt{margin-left:auto;min-width:20px;padding:0 6px;border-radius:4px;background:#a3182c;color:#fff;font-size:12px;font-weight:600;line-height:18px;text-align:center}.ds-activo .ds-cnt{background:#fff;color:#a3182c}"
    },
    {
      "name": "Sellos de estado",
