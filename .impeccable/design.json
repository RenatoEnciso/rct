    {
      "name": "Banda de indicadores",
      "kind": "custom",
      "refersTo": "kpi-celda",
      "description": "Un patio dividido en celdas por muros internos; único componente de KPI.",
      "html": "<div class=\"ds-kpis\"><div class=\"ds-kpi\"><span class=\"ds-kl\">Monto recuperado</span><strong>S/ 7 276 344</strong><small>promedio mensual</small></div><div class=\"ds-kpi\"><span class=\"ds-kl ds-ok\">Aprobadas</span><strong>296</strong><small>de 361 propuestas</small></div><div class=\"ds-kpi\"><span class=\"ds-kl ds-warn\">Observadas</span><strong>18</strong><small>esperan corrección</small></div></div>",
      "css": ".ds-kpis{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:#fff;border:1px solid #e3e6ea;border-radius:8px;overflow:hidden;font-family:'Inter',system-ui,sans-serif}.ds-kpi{padding:16px 20px;box-shadow:1px 0 0 #e3e6ea,0 1px 0 #e3e6ea}.ds-kl{display:flex;align-items:center;gap:6px;font-size:13px;font-weight:500;color:#5f6b7a}.ds-kl.ds-ok::before,.ds-kl.ds-warn::before{content:'';width:8px;height:8px;border-radius:2px;background:#1f7a4d}.ds-kl.ds-warn::before{background:#d08a1e}.ds-kpi strong{display:block;margin:6px 0 2px;font-size:24px;font-weight:700;letter-spacing:-.02em;line-height:1.15;color:#1c2430;font-variant-numeric:tabular-nums;white-space:nowrap}.ds-kpi small{font-size:12px;color:#5f6b7a}"
