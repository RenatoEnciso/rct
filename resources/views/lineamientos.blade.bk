<script>
/**
 * Calculadora de beneficio máximo
 * Lógica basada en Anexo I de la campaña
 */
function calcularBeneficio() {
    const cartera       = document.getElementById('calc_cartera').value;
    const calificacion  = document.getElementById('calc_calificacion').value;
    const tipoCredito   = document.getElementById('calc_tipo_credito').value;
    const dias          = parseInt(document.getElementById('calc_dias').value) || 0;
    const cuotas        = parseInt(document.getElementById('calc_cuotas').value) || 0;
    const condicion     = document.getElementById('calc_condicion').value;

    if (!cartera || !calificacion || !condicion) {
        document.getElementById('calc_resultado').style.display = 'none';
        document.getElementById('calc_vacio').style.display = 'block';
        return;
    }

    let intereses   = '—';
    let capital     = 'No aplica';
    let funcionario = '—';

    // ── FOCMAC ──────────────────────────────────────────────────
    if (cartera === 'focmac') {
        intereses   = '100%';
        capital     = 'Hasta 90%';
        funcionario = 'Coordinador de Normalización de Cartera';
    }

    // ── CASTIGADA ────────────────────────────────────────────────
    else if (cartera === 'castigada') {
        intereses   = '100%';
        capital     = dias <= 1095 ? 'Hasta 70%' : 'Hasta 80%'; // 3 años = 1095 días aprox
        funcionario = 'Coordinador de Normalización de Cartera';
    }

    // ── JUDICIAL / EXTRAJUDICIAL ─────────────────────────────────
    else if (cartera === 'judicial') {
        intereses   = '100%';
        capital     = 'Hasta 70%';
        funcionario = 'SK < 3 UITs: Coordinador Zonal de Recuperaciones · SK > 3 UITs: Jefe de Recuperaciones';
    }

    // ── CANCELACIÓN TOTAL — VENCIDA / REPROGRAMADA / REFINANCIADA
    else if (condicion === 'cancelacion') {
        if (cartera === 'refinanciada') {
            if (['deficiente','dudoso','perdida'].includes(calificacion)) {
                if (dias >= 31 && dias <= 60) {
                    intereses   = '100% intereses + moratorio';
                    capital     = 'Hasta 25% SK (refinanciados)';
                    funcionario = 'CZR (SK < 3 UITs) · Jefe Recuperaciones (SK > 3 UITs)';
                } else if (dias >= 61) {
                    intereses   = '100% intereses + moratorio';
                    capital     = 'Hasta 50% SK';
                    funcionario = 'CZR (SK < 3 UITs) · Jefe Recuperaciones (SK > 3 UITs)';
                }
            } else if (calificacion === 'cpp') {
                intereses   = 'Hasta 70% intereses + 100% moratorio';
                capital     = 'No aplica';
                funcionario = 'Jefe Zonal de Tiendas';
            }
        } else {
            if (calificacion === 'cpp') {
                intereses   = 'Hasta 50% intereses + 100% moratorio';
                capital     = 'No aplica';
                funcionario = 'Jefe Zonal de Tiendas';
            } else if (['deficiente','dudoso','perdida'].includes(calificacion)) {
                if (dias >= 31 && dias <= 60) {
                    intereses   = 'Hasta 100% intereses + moratorio';
                    capital     = 'No aplica';
                    funcionario = 'Coordinador Zonal de Recuperaciones';
                } else if (dias >= 61) {
                    intereses   = 'Hasta 100% intereses + moratorio';
                    capital     = 'Hasta 50% SK';
                    funcionario = 'CZR (SK < 3 UITs) · Jefe Recuperaciones (SK > 3 UITs)';
                }
            }
        }
    }

    // ── PAGO DE CUOTAS ───────────────────────────────────────────
    else if (condicion === 'cuotas') {

        // Refinanciados Dudoso/Pérdida 9–30 días
        if (cartera === 'refinanciada' && ['dudoso','perdida'].includes(calificacion) && dias >= 9 && dias <= 30 && cuotas >= 1) {
            intereses   = 'Hasta 30% intereses + 100% moratorio';
            funcionario = 'Coordinador Zonal de Recuperaciones';
        }
        // Refinanciados cualquier calificación >= 31 días
        else if (cartera === 'refinanciada' && dias >= 31 && cuotas >= 1) {
            intereses   = 'Hasta 60% intereses + 100% moratorio';
            funcionario = 'Coordinador Zonal de Recuperaciones';
        }
        // Hipotecarios CPP >= 61 días
        else if (tipoCredito === 'hipotecario' && calificacion === 'cpp' && dias >= 61) {
            intereses   = cuotas >= 1 ? 'Hasta 50% intereses + 100% moratorio' : '—';
            funcionario = 'Coordinador Zonal de Recuperaciones';
        }
        // Hipotecarios Deficiente/Dudoso/Pérdida >= 61 días
        else if (tipoCredito === 'hipotecario' && ['deficiente','dudoso','perdida'].includes(calificacion) && dias >= 61) {
            if (cuotas >= 2) {
                intereses = 'Hasta 80% intereses + 100% moratorio';
            } else {
                intereses = 'Hasta 60% intereses + 100% moratorio';
            }
            funcionario = 'Coordinador Zonal de Recuperaciones';
        }
        // Cualquier calificación, se pone al día (>= 61 días)
        else if (dias >= 61 && cuotas === 0) {
            intereses   = 'Hasta 80% intereses + 100% moratorio';
            funcionario = 'Coordinador Zonal de Recuperaciones';
        }
        // Deficiente/Dudoso/Pérdida no hipotecario >= 61 días
        else if (['deficiente','dudoso','perdida'].includes(calificacion) && dias >= 61 && tipoCredito !== 'hipotecario') {
            if (dias >= 91 && cuotas >= 3) {
                intereses = 'Hasta 70% intereses + 100% moratorio';
            } else if (dias >= 61 && cuotas >= 2) {
                intereses = 'Hasta 60% intereses + 100% moratorio';
            } else {
                intereses = 'Hasta 40% intereses + 100% moratorio';
            }
            funcionario = 'Coordinador Zonal de Recuperaciones';
        }
        // General 31-60 días
        else if (dias >= 31 && dias <= 60 && cuotas >= 1) {
            if (tipoCredito === 'pequena_empresa') {
                intereses = 'Hasta 40% intereses + 100% moratorio';
            } else {
                intereses = 'Hasta 30% intereses + 100% moratorio';
            }
            funcionario = 'Coordinador Zonal de Recuperaciones';
        }
    }

    // Mostrar resultado
    document.getElementById('res_intereses').textContent  = intereses;
    document.getElementById('res_capital').textContent    = capital;
    document.getElementById('res_funcionario').textContent = funcionario;
    document.getElementById('calc_vacio').style.display    = 'none';
    document.getElementById('calc_resultado').style.display = 'block';
}
</script>
@endpush